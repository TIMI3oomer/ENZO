# Frontend env. Copy to .env (local) or add in Vercel -> frontend project ->
# Settings -> Environment Variables. Everything here ships to the browser, so
# it must be PUBLIC values only -- never the service_role or Stripe secret key.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" / public key (Supabase -> Project Settings -> API).
VITE_SUPABASE_ANON_KEY=

# Backend API base URL, including /api
VITE_API_URL=http://localhost:4000/api

# International format, digits only, e.g. 970599123456
VITE_WHATSAPP_NUMBER=
