# Copy to ".env" and fill in real values. This file lives on the SERVER
# only and is never sent to the browser.
PORT=4000

# Supabase Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# CHECKPOINT NOTE — SECURITY
# This is the service_role key, NOT the anon key. It bypasses Row Level
# Security entirely, which is exactly why it must only ever live here, on
# the server, and never in the React app's .env or any frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Used for CORS - only requests from this origin are allowed to call the API.
FRONTEND_URL=http://localhost:5173

# CHECKPOINT NOTE — ORDER STATUS EMAILS (optional but recommended)
# Used to send customers an email when you change their order's status in
# the admin panel. Leave these blank during early testing -- the server
# will just log emails to the console instead of sending them.
#
# Option A — a real business mailbox (ask your host/domain provider for
# these SMTP settings, e.g. enzo@yourdomain.com):
EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_USER=enzo@yourdomain.com
EMAIL_PASS=your-mailbox-password
EMAIL_FROM=ENZO <enzo@yourdomain.com>

# Option B — Gmail for testing: use an "App Password", not your normal
# Gmail password (Google Account -> Security -> 2-Step Verification ->
# App Passwords). EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=465.
