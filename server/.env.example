# Copy this file to server/.env (local) or add each line in
# Vercel -> backend project -> Settings -> Environment Variables (production).
# NEVER commit the real .env and never paste these values into chat.

# ---------- Required ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: Supabase -> Project Settings -> API. Server-only secret.
SUPABASE_SERVICE_ROLE_KEY=

# Where the storefront lives (comma-separate to allow several). No trailing
# slash. On Vercel make sure it is enabled for the Production environment.
FRONTEND_URL=http://localhost:5173

# ---------- Payments ----------
# Cash on delivery is always available. Choose what else to offer:
#
# Reflect (manual transfer): the customer is shown these details after
# ordering; you mark the order "paid" in the admin panel when it arrives.
# Leave REFLECT_PHONE empty to hide the Reflect option completely.
REFLECT_PHONE=
REFLECT_ACCOUNT_NAME=

# Card payments. Stripe does NOT support businesses located in Palestine, so
# the default is "none" and the Visa option is hidden. Only set "stripe" if
# you hold a working Stripe account, and then fill in the three values below.
CARD_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency Stripe charges in (prices are NOT converted). Default: ils
STRIPE_CURRENCY=ils

# ---------- Order emails (optional) ----------
# Without these the server just logs emails instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=ENZO <you@yourdomain.com>

# ---------- Local development only ----------
PORT=4000
